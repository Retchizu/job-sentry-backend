# =============================================================================
# Phase 6 fused model (recommended for production)
# =============================================================================
# Directory with fused_meta.json (sequential 3-class bundle), DistilBERT tokenizer files,
# and either model.safetensors or checkpoints/epoch_*.pt (epoch_08.pt when present, else highest).
#
# Example (repo root):
#   JOBSENTRY_PHASE6_FUSED_DIR=artifacts/models/phase6_fused
JOBSENTRY_PHASE6_FUSED_DIR=

# Optional: explicit PyTorch checkpoint path (overrides default epoch_08.pt / fallback).
# JOBSENTRY_PHASE6_FUSED_CHECKPOINT=

# Optional: force device — "cpu" or "cuda" (default: auto-detect).
# JOBSENTRY_DEVICE=

# Max job posts per /predict request (default: 50).
JOBSENTRY_MAX_BATCH_SIZE=50

# Fused 3-class: assign fraud when P(fraud) >= this; else legit vs warning from the other two probs.
# POST /predict uses this (see class_from_softmax_triple_with_p_fraud_threshold).
JOBSENTRY_P_FRAUD_DECISION_THRESHOLD=0.4

# Thresholds for map_binary_to_risk (app.risk_labels): scalar P(scam) -> legit/warning/fraud.
# NOT used for default POST /predict. Require WARN < FRAUD.
JOBSENTRY_WARN_THRESHOLD=0.35
JOBSENTRY_FRAUD_THRESHOLD=0.65

# Reserved for future policy (e.g. review queue when max softmax < τ). Not applied by POST /predict.
JOBSENTRY_CONFIDENCE_THRESHOLD=0.5

# =============================================================================
# Legacy DistilBERT-only / hybrid ensemble (not used by current app when above is set)
# =============================================================================
# The service loads only the phase6 fused stack when JOBSENTRY_PHASE6_FUSED_DIR
# is set. Variables below apply only if you restore an older DistilBERT-only app.

# JOBSENTRY_MODEL_ARTIFACT_PATH=thesis-scam-job-post/models/distilbert_run/checkpoint-5412
# JOBSENTRY_MODEL_NAME=distilbert-base-uncased
# JOBSENTRY_MAX_SEQUENCE_LENGTH=512

# JOBSENTRY_PHASE6_MERGED_PATH=
# JOBSENTRY_BILSTM_ARTIFACT_PATH=
# JOBSENTRY_HYBRID_COMBINATION=soft_voting
